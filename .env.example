# Environment Configuration for AutoJobApplier
# Copy this file to .env and fill in your actual values

# JWT Authentication
# Generate a secure random key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-change-this-in-production-use-env-var

# Claude API Configuration
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Database Configuration (optional - defaults to SQLite)
# For production, consider PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/autojobapplier
DATABASE_URL=sqlite:///data/applications.db

# Application Settings
ENVIRONMENT=development  # development, staging, production
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
SESSION_EXPIRE_MINUTES=30

# Rate Limiting (requests per time period)
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SEARCH=20/hour
RATE_LIMIT_APPLY=10/hour
RATE_LIMIT_UPLOAD=10/hour

# Job Application Settings
MAX_APPLICATIONS_PER_DAY=20
AUTO_SUBMIT=false
HEADLESS=true

# File Upload Limits
MAX_RESUME_SIZE_MB=10
ALLOWED_RESUME_EXTENSIONS=.pdf,.docx,.doc,.txt

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
